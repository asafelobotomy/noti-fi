# ============================================================ development
def cmd_dev(a):
    """Run a throwaway daemon from the source on a private D-Bus session (never touches the real one)."""
    p = paths()
    if not SRC.exists():
        print("no source folder; run `notify dev` from the project checkout")
        return 1
    p["dev_bus"].parent.mkdir(parents=True, exist_ok=True)
    p["dev_state"].mkdir(parents=True, exist_ok=True)
    env = dict(os.environ, QT_NO_XDG_DESKTOP_PORTAL="1", XDG_STATE_HOME=str(p["dev_state"]))
    print("dev daemon starting on a private bus; Ctrl+C stops it.\nIn another terminal try:  notify --dev test    notify --dev dnd on")
    proc = subprocess.Popen(["dbus-run-session", "--", "bash", "-c",
                             f'echo "$DBUS_SESSION_BUS_ADDRESS" > {p["dev_bus"]}; exec qs -p {SRC}'], env=env, start_new_session=True)
    try:
        return proc.wait()
    except KeyboardInterrupt:
        import signal
        os.killpg(proc.pid, signal.SIGTERM)
        proc.wait(timeout=8)
        return 0
    finally:
        if p["dev_bus"].exists():
            p["dev_bus"].unlink()


def cmd_selftest(_):
    t = HERE.parent / "tests" / "test_notifd.py"
    if not t.exists():
        print("tests/test_notifd.py not found (run from the project checkout)")
        return 1
    return subprocess.run([sys.executable, "-I", str(t)]).returncode


