        return 0
    atomic_write(desktop, f"[Desktop Entry]\nType=Application\nName={HOTKEY_NAME}\nExec={exe_path()} dnd toggle\nNoDisplay=true\n"
                          "X-KDE-GlobalAccel-CommandShortcut=true\n")
    sh("kbuildsycoca6")
    rc, _ = kga("doRegister", "as", "4", HOTKEY_DESKTOP, "_launch", "", HOTKEY_NAME)
    rc2, _ = kga("setShortcut", "asaiu", "4", HOTKEY_DESKTOP, "_launch", "", HOTKEY_NAME, "1", str(code), "3")
    if rc or rc2:
        print("could not register with KDE's shortcut service; set it in System Settings -> Shortcuts -> Add Command instead")
        return 1
    print("registered. Press it to toggle Do Not Disturb. Change it in System Settings -> Shortcuts if you like.")
    return 0


# ============================================================ simulate / preview (the daemon decides)
def cmd_simulate(a):
    """Ask the running daemon what it would do with a notification. Same code path as a real one."""
    req = {"notification": {"appName": a.app, "desktopEntry": a.entry, "origin": a.origin, "summary": a.summary,
                            "body": a.body or "", "urgency": a.urgency, "expireTimeout": a.timeout}}
    if a.ignore_state:
        req["ignoreState"] = True
    if a.config:
        try:
            req["config"] = json.loads(Path(a.config).read_text())
        except (OSError, ValueError) as e:
            print(f"cannot read --config: {e}")
            return 1
    d = ipc("simulate", json.dumps(req))
    if d is None:
        return 1
    if a.json:
        print(json.dumps(d, indent=1))
        return 0
    by = d["decidedBy"]
    def why(k):
        return f" (rule '{by[k]}')" if by[k] else " (default)"
    print(f"zone:     {d['zone']}{why('zone')}")
    print(f"timeout:  {'stays until dismissed' if d['timeout'] == 0 else str(d['timeout']) + ' ms'}{why('timeout')}")
    print(f"outcome:  {'shown' if d['wouldShow'] else 'NOT shown: ' + d['hold']}")
    print(f"matched:  {', '.join(d['matched']) if d['matched'] else 'no rules (defaults apply)'}")
    return 0


def cmd_preview(a):
    """Show real popups on screen with a draft config (or the current one) for a few seconds."""
    if a.end:
        return 0 if ipc("endPreview") is not None else 1
    req = {"seconds": a.seconds}
    if a.config:
        try:
            req["config"] = json.loads(Path(a.config).read_text())
        except (OSError, ValueError) as e:
            print(f"cannot read --config: {e}")
            return 1
    d = ipc("preview", json.dumps(req))
    if d is None:
        return 1
    print(f"previewing {d['shown']} sample popups for {d['seconds']}s" + (" using the draft config" if a.config else ""))
    return 0


# ============================================================ daily controls
def show_state(d):
    print(f"Do Not Disturb: {'ON' if d['dnd'] else 'off'}   muted zones: {', '.join(d['muted']) or 'none'}   "
          f"on screen: {d['active']}   history: {d['history']}")


def cmd_dnd(a):
    d = ipc("status") if a.mode == "status" else ipc("dnd", a.mode)
    if d is None:
        return 1
    show_state(d)
    return 0


def cmd_mute(a):
    d = ipc("mute", a.zone, "true" if a.cmd == "mute" else "false")
    if d is None:
        return 1
    show_state(d)
    return 0


def cmd_dismiss(_):
    d = ipc("dismissAll")
    if d is None:
        return 1
    print("dismissed everything on screen")
    return 0


def cmd_history(a):
    if a.clear:
        if ipc("clearHistory") is None:
            return 1
        print("history cleared")
        return 0
    items = ipc("history", 1000)
    if items is None:
        return 1
    if a.zone:
        items = [i for i in items if i["zone"] == a.zone]
    if a.app:
        items = [i for i in items if re.search(a.app, i["app"] or "", re.I)]
    if a.missed:
        items = [i for i in items if not i["shown"]]
    items = items[: a.n]
    if a.json:
        print(json.dumps(items, indent=1))
        return 0
    if not items:
        print("no notifications in history")
        return 0
    for i in items:
        t = datetime.datetime.fromtimestamp(i["t"] / 1000).strftime("%H:%M:%S")
        flag = f"  [{i['why']}]" if not i["shown"] else ""
        site = f" ({i['origin']})" if i["origin"] else ""
        upd = f" (updated x{i['updates']})" if i.get("updates") else ""
        print(f"{t}  {i['zone']:<9} {i['app']}{site}: {i['summary']}{upd}{flag}")
        if a.full and i["body"]:
            print(f"          {i['body']}")
    return 0


def cmd_send(a):
    cmd = ["notify-send", "-a", a.app, "-u", a.urgency, "-t", str(a.timeout)]
    if a.origin:
        cmd += ["-h", f"string:x-kde-origin-name:{a.origin}"]
    if a.desktop_entry:
        cmd += ["-h", f"string:desktop-entry:{a.desktop_entry}"]
    cmd += [a.summary] + ([a.body] if a.body else [])
    return subprocess.run(cmd).returncode


