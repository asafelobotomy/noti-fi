# Maintainer: asafelobotomy
# Builds noti-fi against the Qt installed on YOUR machine (the panel's compiled QML only runs on the Qt it was built with, so a prebuilt
# panel from the release archive works only on a matching Qt). Use:   cd packaging && makepkg -si
# After a Qt upgrade the panel may stop starting; run makepkg -si again to rebuild it.
pkgname=noti-fi
pkgver=0.12.0
pkgrel=1
pkgdesc="Notification daemon (notifd), command line (notify) and control panel for KDE Plasma on Wayland"
arch=('x86_64')
url="https://github.com/asafelobotomy/noti-fi"
license=('MIT')
depends=('quickshell' 'qt6-base' 'qt6-declarative' 'kirigami' 'qqc2-desktop-style')
makedepends=('cargo' 'git')
optdepends=('qt6-multimedia: audio and video players in popups' 'flatpak: per-app notification permissions for Flatpak apps')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')   # fill in with `updpkgsums` before publishing the package elsewhere

build() {
    cd "$pkgname-$pkgver"
    cargo build --release --locked -p notify-cli -p notify-panel
}

package() {
    cd "$pkgname-$pkgver"
    install -Dm755 target/release/notify target/release/notify-panel -t "$pkgdir/usr/bin"
    install -Dm644 packaging/org.notify.Panel.desktop -t "$pkgdir/usr/share/applications"
    install -Dm644 packaging/org.notify.Panel.metainfo.xml -t "$pkgdir/usr/share/metainfo"
    install -Dm644 packaging/org.notify.Panel.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps"
    install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
    install -Dm644 README.md -t "$pkgdir/usr/share/doc/$pkgname"
}
