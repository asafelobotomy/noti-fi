            desktop.unlink()
        print("hotkey removed")
        return 0
    try:
        code = qt_keycode(a.keys)
    except ValueError as e:
        print(f"error: {e}")
        return 1
    print(f"{a.keys} -> {exe_path()} dnd toggle")
    if a.dry_run:
