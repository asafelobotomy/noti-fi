        if a.background and not bg:
            changes.append((ls_f, ls, "background_mode.enabled", True, "keep running in the background"))

        if changes:
            for _, _, key, val, label in changes:
                line(INFO, f"will set {key} = {val}  ({label})")
            if a.apply:
                if exe_running(*RUNNING_NEEDLES.get(entry, (entry,))):
                    line(BAD, f"{name} is running; it would overwrite the change on exit", "close all Brave windows (and its tray icon), then retry")
                    rc = 1
                    continue
                stamp = paths()["backups"] / datetime.datetime.now().strftime("%Y%m%d-%H%M%S") / name.replace(" ", "-")
                stamp.mkdir(parents=True, exist_ok=True)
                files = {c[0]: c[1] for c in changes}
                for f in files:
                    shutil.copy2(f, stamp / f.name)
