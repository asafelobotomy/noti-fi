def cmd_takeover(a):
    p = paths()
    errs = lint_config(json.loads((SRC / "rules.json").read_text())) if (SRC / "rules.json").exists() else ["no source rules.json"]
    if errs:
        print("refusing: source rules.json invalid:", "; ".join(errs))
        return 1
    if not shutil.which("qs") and not a.no_systemctl:
        print("refusing: quickshell (qs) not installed")
        return 1
    missing = [f for f in PAYLOAD_FILES if not (SRC / f).exists()]
    if missing:
        print(f"refusing: missing daemon files in {SRC}: {missing}")
        return 1
    if p["state"].exists():
        print("notifd takeover is already installed (use 'notify update' to change it, or 'notify restore' first)")
        return 1

    print(("DRY RUN - " if a.dry_run else "") + "takeover plan")
    plan = Plan(a.dry_run)

    def install_payload():
        p["payload"].mkdir(parents=True, exist_ok=True)
        for f in PAYLOAD_FILES:
            shutil.copy2(SRC / f, p["payload"] / f)
    plan.add(f"copy daemon ({', '.join(PAYLOAD_FILES)}) to {p['payload']}", install_payload)

    def install_rules():
        if not p["rules"].exists():
            p["rules"].parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(SRC / "rules.json", p["rules"])
        link = p["payload"] / "rules.json"
        if link.is_symlink() or link.exists():
            link.unlink()
        link.symlink_to(p["rules"])
    plan.add(f"config at {p['rules']} (kept if it exists), linked into the daemon folder", install_rules)
    plan.add(f"write user unit {p['unit']} (starts before plasmashell)", lambda: atomic_write(p["unit"], unit_text(p["payload"])))
    plan.add(f"write fallback unit {p['fallback_unit']} (hands back to Plasma if notifd keeps failing)",
             lambda: atomic_write(p["fallback_unit"], fallback_unit_text()))
    plan.add(f"write D-Bus activation override {p['dbus']} (restarts notifd if it ever stops)", lambda: atomic_write(p["dbus"], dbus_text()))
    autodnd_done = []
    if not a.no_autodnd:
        plan.add("install the KWin script for automatic Do Not Disturb (full-screen windows)", lambda: autodnd_done.append(autodnd_install()) if not a.no_systemctl else None)
    portal_done = []
    if not a.no_portal:
        plan.add(f"route Flatpak/portal notifications through notifd ({p['portal']})", lambda: portal_done.append(portal_enable(a)))
    plan.add("systemctl --user daemon-reload", lambda: systemctl(a, "daemon-reload"))
    plan.add("systemctl --user enable notifd.service (active from next login)", lambda: systemctl(a, "enable", "notifd.service"))
    plan.add(f"record what was installed in {p['state']} (restore removes exactly these)", lambda: atomic_write(
        p["state"], json.dumps({"unit": str(p["unit"]), "fallback_unit": str(p["fallback_unit"]), "dbus": str(p["dbus"]),
                                "portal": str(p["portal"]) if portal_done and portal_done[0] else None,
                                "autodnd": bool(autodnd_done and autodnd_done[0])}, indent=1)))

    if a.now:
        def live():
            systemctl(a, "stop", "plasma-plasmashell.service")
            rc = systemctl(a, "start", "notifd.service")
            systemctl(a, "start", "plasma-plasmashell.service")
            if not a.no_systemctl and (rc != 0 or not notifd_owns()):
                print("  ! takeover did not take effect; rolling back")
                do_restore(a, quiet=True)
                raise SystemExit(1)
        plan.add("NOW: stop plasmashell, start notifd, start plasmashell (panel disappears ~5s); auto-rollback if notifd is not the owner", live)
    else:
        plan.add("(no --now: nothing running changes; notifd takes over at next login)")
    plan.run()
    print("\nDry run only; nothing was changed." if a.dry_run else "\nDone. Undo any time with: notify restore")
    return 0


def merge_new_defaults(src_rules: Path, dst_rules: Path):
    """Add config keys that exist in the source defaults but not in the user's file. Never overwrites."""
    try:
        s, d = json.loads(src_rules.read_text()), json.loads(dst_rules.read_text())
    except (OSError, ValueError):
        return []
    added = [k for k in s if k not in d]
    if added:
        for k in added:
            d[k] = s[k]
        atomic_write(dst_rules, json.dumps(d, indent=2) + "\n")
    return added


def healthy(timeout=15, abandoned_if_missing=None):
    """notifd owns the name and answers on IPC (works for any version, old or new).
    Returns False early if abandoned_if_missing (the takeover record) disappears: the automatic
    fallback has fired and there is nothing left to wait for."""
    end = time.time() + timeout
    while time.time() < end:
        if notifd_owns() and ipc("status", quiet=True) is not None:
            return True
        if abandoned_if_missing is not None and not abandoned_if_missing.exists():
            return False
        time.sleep(0.5)
    return False


def preflight(files_dir: Path, rules: Path, timeout=30):
    """Start the new daemon on a private D-Bus session and check it comes up and answers.
    This runs BEFORE the live daemon is touched, so a broken version can never take notifications down."""
    import signal
    tmp = Path(tempfile.mkdtemp(prefix="notifd-preflight-"))
    try:
        for f in PAYLOAD_FILES:
            shutil.copy2(files_dir / f, tmp / f)
        shutil.copy2(rules, tmp / "rules.json")
        (tmp / "state").mkdir()
        env = dict(os.environ, QT_NO_XDG_DESKTOP_PORTAL="1", XDG_STATE_HOME=str(tmp / "state"))
        proc = subprocess.Popen(["dbus-run-session", "--", "bash", "-c", f"exec qs -p {tmp}"], env=env,
                                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        ok = False
        end = time.time() + timeout
        while time.time() < end and proc.poll() is None:
            rc, out = sh("qs", "-p", str(tmp), "ipc", "call", "notifd", "status")
            if rc == 0 and out:
                ok = True
                break
            time.sleep(0.5)
        try:
            os.killpg(proc.pid, signal.SIGTERM)
            proc.wait(timeout=8)
        except (ProcessLookupError, subprocess.TimeoutExpired):
            pass
        return ok
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def cmd_update(a):
    p = paths()
    if not p["state"].exists():
        print("takeover is not installed; run 'notify takeover' first")
        return 1
    if not SRC.exists():
        print(f"no source folder at {SRC}; run update from the project checkout")
        return 1
    missing = [f for f in PAYLOAD_FILES if not (SRC / f).exists()]
    if missing:
        print(f"refusing: missing {missing} in {SRC}")
        return 1
    if not a.no_systemctl:
        print("  smoke-testing the new version on a private bus (your live notifications are not touched)...")
        rules_for_test = p["rules"] if p["rules"].exists() else SRC / "rules.json"
        if not preflight(SRC, rules_for_test):
            print("  ! the new version failed its smoke test, so NOTHING was changed. Fix it, or run `notify dev` to see the errors.")
            return 1
        print("  smoke test passed")
    # keep the working version so a bad update can be undone
    p["prev"].mkdir(parents=True, exist_ok=True)
    for f in PAYLOAD_FILES:
        if (p["payload"] / f).exists():
            shutil.copy2(p["payload"] / f, p["prev"] / f)
    for f in PAYLOAD_FILES:
        shutil.copy2(SRC / f, p["payload"] / f)
        print(f"  updated {f}")
    for key, text in (("unit", unit_text(p["payload"])), ("fallback_unit", fallback_unit_text()), ("dbus", dbus_text())):
        if not p[key].exists() or p[key].read_text() != text:
            atomic_write(p[key], text)
            print(f"  refreshed {p[key].name}")
    added = merge_new_defaults(SRC / "rules.json", p["rules"])
    if added:
        print(f"  added new settings to your rules.json (existing values untouched): {', '.join(added)}")
    if a.no_systemctl:
        return 0
    systemctl(a, "daemon-reload")
    systemctl(a, "restart", "notifd.service")
    print("  restarted notifd.service (notifications pause for about a second)")
    if healthy(abandoned_if_missing=p["state"]):
        print("  health check passed")
        return 0
    if not p["state"].exists():
        print("  ! notifd kept crashing and the automatic fallback has handed notifications back to Plasma.")
        print("    Fix the problem, then re-enable with: notify takeover --now")
        return 1
    print("  ! notifd did not come back healthy; rolling back to the previous version")
    for f in PAYLOAD_FILES:
        if (p["prev"] / f).exists():
            shutil.copy2(p["prev"] / f, p["payload"] / f)
    systemctl(a, "reset-failed", "notifd.service")
    systemctl(a, "restart", "notifd.service")
    print("  rolled back and restarted: " + ("notifd is healthy again" if healthy() else "STILL NOT HEALTHY - run: notify restore"))
    return 1


def do_restore(a, quiet=False, auto=False):
    p = paths()
    state = {}
    if p["state"].exists():
        try:
            state = json.loads(p["state"].read_text())
        except ValueError:
            pass
    systemctl(a, "disable", "--now", "notifd.service")
    for key in ("unit", "fallback_unit", "dbus"):
        f = Path(state.get(key) or p[key])
        if f.exists():
            f.unlink()
    portal_changed = portal_disable(a)
    if state.get("autodnd") and not a.no_systemctl:
        autodnd_remove()
    if not a.no_systemctl:
        systemctl(a, "daemon-reload")
        systemctl(a, "reset-failed", "notifd.service")
        for _ in range(6):                    # give a queued plasmashell a moment to take the name
            if owner():
                break
            time.sleep(0.5)
        if not owner():                       # nobody owns it -> bring Plasma's back
            systemctl(a, "restart", "plasma-plasmashell.service")
    if p["state"].exists():
        p["state"].unlink()
    if getattr(a, "purge", False):
        shutil.rmtree(p["payload"], ignore_errors=True)
        shutil.rmtree(p["prev"], ignore_errors=True)
    if not quiet:
        print("restored: Plasma owns notifications again" + ("; portal routing removed" if portal_changed else ""))
    if auto and not a.no_systemctl:
        for _ in range(20):
            if owner():
                break
            time.sleep(0.5)
        sh("notify-send", "-a", "noti-fi", "-u", "critical", "Notification daemon failed",
           "notifd kept failing, so notifications were handed back to Plasma. Check the setup, then run: notify takeover --now")


def cmd_restore(a):
