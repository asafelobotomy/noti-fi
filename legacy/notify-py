HOTKEY_NAME = "Toggle Do Not Disturb (noti-fi)"
QT_MODS = {"meta": 0x10000000, "super": 0x10000000, "shift": 0x02000000, "ctrl": 0x04000000, "control": 0x04000000, "alt": 0x08000000}


def qt_keycode(combo):
    """'Meta+Shift+N' -> Qt key integer. Supports modifiers plus one letter, digit or F1-F12."""
    code = 0
    for part in combo.split("+"):
        k = part.strip().lower()
        if k in QT_MODS:
            code |= QT_MODS[k]
        elif len(k) == 1 and (k.isalpha() or k.isdigit()):
            code |= ord(k.upper())
        elif re.fullmatch(r"f([1-9]|1[0-2])", k):
            code |= 0x01000030 + int(k[1:]) - 1
        else:
            raise ValueError(f"unsupported key '{part}'")
    if code & 0x00FFFFFF == 0:
        raise ValueError("needs a main key, like Meta+Shift+N")
    return code


def kga(*args):
    return sh("busctl", "--user", "call", "org.kde.kglobalaccel", "/kglobalaccel", "org.kde.KGlobalAccel", *args)


