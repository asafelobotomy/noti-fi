#!/usr/bin/env python3
"""LEGACY Python version of `notify` (superseded by the Rust CLI in crates/notify-cli).
Kept only so tests/parity.py can prove the Rust CLI does exactly what this one did.

notify - manage the notifd notification system.

Inspect (read-only):
  status [--json]              who owns notifications, daemon state, config errors
  doctor                       run every check and say what needs attention
  apps [--json]                browsers and apps, and how ready each is for notifications
  rules [--file F] [--json]    validate rules.json (static lint + the running daemon's verdict, without applying a --file)
  simulate [SUMMARY] --app A   ask the daemon what it would do with a notification (--origin --entry -u --config DRAFT)
  preview [--config DRAFT]     show real sample popups on screen with the current or a draft config

Install / maintain (each supports --dry-run where it changes your system, and is reversible):
  takeover [--now] [--no-portal]   install notifd as a user service that owns notifications
  update                           install changed daemon files; rolls back if notifd won't start
  restore [--purge]                hand notifications back to Plasma
  portal [--remove]                route Flatpak/portal notifications through notifd
  adapt [--apply] [--background] [--autostart]   make Brave deliver notifications
  hotkey [KEYS] [--remove]         global shortcut that toggles Do Not Disturb (default Meta+Shift+N)

Daily controls (talk to the running daemon):
  dnd [on|off|toggle|status]   Do Not Disturb (critical alerts still show by default)
  mute ZONE / unmute ZONE      silence a zone but keep it in history
  history                      recent notifications (--missed --zone --app --full --json --clear)
  dismiss                      close every popup on screen
  reply ID TEXT                answer a notification that accepts replies
  autodnd [install|remove]     pause popups automatically while a window is full screen (KWin script)
  tray [hide|show]             Plasma's own notification icon in the system tray
  send SUMMARY [BODY]          send a notification (--app --origin SITE -u urgency -t ms)
  test                         send samples to every zone

Development:
  dev                          run a throwaway daemon from the source on a private bus
  selftest                     run the regression suite (also on a private bus)
  --dev (before any command)   point commands at the `dev` daemon instead of the real one
"""
import argparse, configparser, datetime, glob, json, os, re, shutil, sqlite3, subprocess, sys, tempfile, time
from pathlib import Path

HOME = Path.home()
HERE = Path(__file__).resolve().parent
SRC = HERE.parent / "notifd"           # the project checkout (this file lives in legacy/)
NAME = "org.freedesktop.Notifications"
PAYLOAD_FILES = tuple(sorted(("shell.qml", "Popup.qml", "Media.qml", "TransferChart.qml", "Validate.qml", "Transfers.qml", "MediaFile.qml", "TimerIndicators.qml", "TimerRing.qml", "ZoneWindows.qml", "Osd.qml", "PopupGraph.qml", "PopupReply.qml", "rules.schema.json")))   # sorted like the Rust build, which embeds whatever is in notifd/
OK, WARN, BAD, INFO = "ok", "warn", "FAIL", "info"
PORTAL_MARK = "# managed by notify: routes portal notifications through notifd"
DEV = False


# ============================================================ helpers
def xdg(var, default):
    return Path(os.environ.get(var) or HOME / default)


def paths():
    cfg, data, state = xdg("XDG_CONFIG_HOME", ".config"), xdg("XDG_DATA_HOME", ".local/share"), xdg("XDG_STATE_HOME", ".local/state")
    desktop = (os.environ.get("XDG_CURRENT_DESKTOP") or "KDE").split(":")[0].lower()
    return {
        "unit": cfg / "systemd/user/notifd.service",
        "fallback_unit": cfg / "systemd/user/notifd-fallback.service",
        "dbus": data / "dbus-1/services/org.freedesktop.Notifications.service",
        "payload": data / "notifd",
        "prev": data / "notifd.prev",
        "rules": cfg / "notifd/rules.json",
        "portal": cfg / f"xdg-desktop-portal/{desktop}-portals.conf",
        "portal_system": Path(f"/usr/share/xdg-desktop-portal/{desktop}-portals.conf"),
        "state": state / "notifd/takeover.json",
        "dev_bus": state / "notify/dev.bus",
        "dev_state": state / "notify/dev-state",
        "backups": state / "notify/backups",
    }


def sh(*cmd, timeout=10):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return r.returncode, r.stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return 1, ""


def line(level, msg, hint=None):
    print(f"  [{level:>4}] {msg}")
    if hint:
        print(f"         -> {hint}")


def atomic_write(path: Path, text: str):
    """Write via a temp file + rename so a crash can never leave a half-written file."""
    path.parent.mkdir(parents=True, exist_ok=True)
    mode = path.stat().st_mode & 0o777 if path.exists() else 0o644
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.")
    try:
        with os.fdopen(fd, "w") as f:
            f.write(text)
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def exe_path():
    p = HOME / ".local/bin/notify"
    return str(p) if p.exists() else str(HERE / "notify")


def systemctl(a, *cmd):
    if a.no_systemctl:
        return 0
    rc, _ = sh("systemctl", "--user", *cmd, timeout=30)
    return rc


def owner():
    rc, out = sh("busctl", "--user", "status", NAME)
    if rc != 0:
        return None
    d = dict(l.split("=", 1) for l in out.splitlines() if "=" in l)
    return {"pid": d.get("PID"), "comm": d.get("Comm"), "unit": d.get("UserUnit")}


def notifd_owns():
    o = owner()
    return bool(o and o["comm"] in ("qs", "quickshell"))


def qs_target():
    if DEV:
        return SRC
    installed = paths()["payload"]
    return installed if installed.exists() else SRC


def ipc(fn, *args, quiet=False):
    """Call a function on the running notifd via Quickshell IPC; parsed JSON or None."""
    rc, out = sh("qs", "-p", str(qs_target()), "ipc", "call", "notifd", fn, *map(str, args))
    if rc != 0 or not out:
        if not quiet:
            print("notifd is not running (or does not answer). Start it with: systemctl --user start notifd"
                  + (" -- or `notify dev` for the dev daemon" if DEV else ""), file=sys.stderr)
        return None
    try:
        d = json.loads(out)
    except ValueError:
        if not quiet:
            print(f"unexpected reply: {out}", file=sys.stderr)
        return None
    if isinstance(d, dict) and set(d) == {"error"}:      # a failure reply carries only an error
        if not quiet:
            print(f"error: {d['error']}", file=sys.stderr)
        return None
    return d


def exe_running(*needles):
    """True if any process runs a binary whose path contains one of the needles."""
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        try:
            exe = os.readlink(f"/proc/{pid}/exe")
        except OSError:
            continue
        if any(n in exe for n in needles):
            return True
    return False


# ============================================================ rules validation
# keep in sync with matchFields / anchorNames in notifd/shell.qml; the daemon is authoritative
MATCH_FIELDS = ("appName", "desktopEntry", "origin", "summary", "body", "urgency")
ANCHORS = ("top-left", "top-right", "bottom-left", "bottom-right")
JS_INCOMPATIBLE = [
    (r"\(\?P[<=]", "named groups are written (?<name>...) in JavaScript, not (?P<name>...)"),
    (r"\(\?[aiLmsux]+[:)]", "inline flags like (?i) are not supported (matching is already case-insensitive)"),
    (r"\(\?#", "(?#...) comments are not supported"),
    (r"\\[AZ]", "\\A and \\Z are not supported; use ^ and $"),
]


def lint_config(cfg):
    """Return a list of problems; the same rules the daemon enforces when it loads the file."""
    errs = []
    if not isinstance(cfg, dict):
        return ["top level must be a JSON object"]
    zones = cfg.get("zones")
    if not isinstance(zones, dict) or not zones:
        errs.append("zones: need at least one zone")
        zones = {}
    for z, zz in zones.items():
        if not isinstance(zz, dict) or zz.get("anchor") not in ANCHORS:
            errs.append(f"zone '{z}': anchor must be one of {', '.join(ANCHORS)}")
        elif "accent" in zz and not re.fullmatch(r"#[0-9a-fA-F]{3,8}", str(zz["accent"])):
            errs.append(f"zone '{z}': accent must be a #hex colour")
    if cfg.get("defaultZone", "personal") not in zones:
        errs.append(f"defaultZone '{cfg.get('defaultZone', 'personal')}' is not a defined zone")
    for k in ("defaultTimeout", "width", "margin", "spacing", "maxVisible"):
        if k in cfg and (not isinstance(cfg[k], (int, float)) or isinstance(cfg[k], bool) or cfg[k] < 0):
            errs.append(f"{k} must be a number >= 0")
    ad = cfg.get("autoDnd", {})
    if not isinstance(ad, dict) or any(not isinstance(ad.get(k, True), bool) for k in ("fullscreen", "screenShare")):
        errs.append("autoDnd.fullscreen and autoDnd.screenShare must be true or false")
    rules = cfg.get("rules", [])
    if not isinstance(rules, list):
        return errs + ["rules must be a list"]
    for i, r in enumerate(rules, 1):
        if not isinstance(r, dict):
            errs.append(f"rule #{i}: must be an object")
            continue
        name = r.get("name", f"#{i}")
        if "zone" in r and r["zone"] not in zones:
            errs.append(f"rule '{name}': unknown zone '{r['zone']}'")
        if "timeout" in r and (not isinstance(r["timeout"], (int, float)) or r["timeout"] < 0):
            errs.append(f"rule '{name}': timeout must be a number >= 0")
        match = r.get("match", {})
        if not isinstance(match, dict):
            errs.append(f"rule '{name}': match must be an object")
            continue
        for k, pat in match.items():
            if k not in MATCH_FIELDS:
                errs.append(f"rule '{name}': unknown match field '{k}' (use {', '.join(MATCH_FIELDS)})")
                continue
            try:
                re.compile(pat)
            except (re.error, TypeError) as e:
                errs.append(f"rule '{name}': bad regex for {k}: {e}")
                continue
            for bad, why in JS_INCOMPATIBLE:
                if re.search(bad, pat):
                    errs.append(f"rule '{name}': regex for {k}: {why}")
    return errs


def schema_file():
    for d in (SRC, paths()["payload"]):
        if (d / "rules.schema.json").exists():
            return d / "rules.schema.json"
    return None


def lint_warnings(cfg):
    """Keys the daemon silently ignores (almost always typos), found by walking the JSON Schema."""
    sf = schema_file()
    if not sf:
        return []
    try:
        schema = json.loads(sf.read_text())
    except (OSError, ValueError):
        return []
    out = []

    def walk(val, sch, path):
        if not isinstance(sch, dict):
            return
        if isinstance(val, dict):
            props = sch.get("properties", {})
            extra = sch.get("additionalProperties")
            for k, v in val.items():
                if k in props:
                    walk(v, props[k], f"{path}.{k}" if path else k)
                elif extra is False and k != "name":
                    out.append(f"unknown setting '{(path + '.' if path else '') + k}' (the daemon ignores it; typo?)")
                elif isinstance(extra, dict):
                    walk(v, extra, f"{path}.{k}" if path else k)
        elif isinstance(val, list) and isinstance(sch.get("items"), dict):
            for i, it in enumerate(val):
                walk(it, sch["items"], f"{path}[{i}]")
    walk(cfg, schema, "")
    return out


def rules_file():
    return paths()["rules"] if paths()["rules"].exists() else SRC / "rules.json"


def cmd_rules(a):
    f = Path(a.file) if a.file else rules_file()
    res = {"file": str(f), "errors": [], "warnings": [], "daemon": None}
    try:
        text = f.read_text()
        cfg = json.loads(text)
    except (OSError, ValueError) as e:
        res["errors"].append(f"cannot load: {e}")
        text = cfg = None
    if cfg is not None:
        res["errors"] += lint_config(cfg)
        res["warnings"] = lint_warnings(cfg)
        # the daemon is the authority: ask it about this exact text (installed file: ask for the live verdict)
        if a.file:
            res["daemon"] = ipc("validate", text, quiet=True)
        else:
            c = ipc("configStatus", quiet=True)
            res["daemon"] = None if c is None else {"ok": c["ok"], "error": c["error"], "rules": c["rules"]}
    daemon_bad = bool(res["daemon"]) and not res["daemon"].get("ok")
    if getattr(a, "json", False):
        print(json.dumps(res, indent=1))
        return 1 if (res["errors"] or daemon_bad) else 0
    print(f"Rules: {f}")
    for e in res["errors"]:
        line(BAD, e)
    for w in res["warnings"]:
        line(WARN, w)
    if cfg is not None and not res["errors"]:
        line(OK, f"{len(cfg.get('zones', {}))} zones, {len(cfg.get('rules', []))} rules: valid")
    d = res["daemon"]
    if d is None:
        line(INFO, "daemon not running; only the static lint above applies")
    elif d.get("ok"):
        line(OK, "the running daemon accepts this config" + ("" if not a.file else " (checked without applying it)"))
    else:
        line(BAD, "the running daemon " + ("REJECTS this config: " if a.file else "REJECTED the config and is using the previous one: ") + d["error"])
    return 1 if (res["errors"] or daemon_bad) else 0


