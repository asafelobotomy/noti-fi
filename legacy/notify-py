def status_data():
    o = owner()
    return {"owner": o, "notifd_owns": bool(o and o["comm"] in ("qs", "quickshell")),
            "daemon": ipc("status", quiet=True), "config": ipc("configStatus", quiet=True)}


def cmd_status(a):
    if getattr(a, "json", False):
        print(json.dumps(status_data(), indent=1))
        return 0
    print("Notification ownership")
    o = owner()
    if not o:
        line(WARN, f"nobody owns {NAME}", "notifications from apps are being dropped")
    else:
        mine = o["comm"] in ("qs", "quickshell")
        line(OK if mine else INFO, f"owner: {o['comm']} (pid {o['pid']}, unit {o['unit'] or 'none'})")
        line(INFO, "notifd is the owner" if mine else "stock owner is active (notifd is NOT in control)")
    d = ipc("status", quiet=True)
    if d is None:
        line(INFO, "no notifd instance answering")
        return 0
    line(INFO, f"Do Not Disturb {'ON' if d['dnd'] else 'off'}, muted: {', '.join(d['muted']) or 'none'}, "
               f"{d['active']} on screen" + (f" (+{d['queued']} queued)" if d.get("queued") else "") + f", {d['history']} in history")
    if d.get("holding") and d["holding"] != "dnd":
        line(INFO, f"holding popups automatically: {d['holding']} (critical ones still show)")
    if d.get("cfgError"):
        line(BAD, f"rules.json rejected, running on the previous config: {d['cfgError']}", "fix it, then check with: notify rules")
    return 0


def cmd_doctor(a):
    p = paths()
    print("Tools")
    for t, why in (("qs", "Quickshell runs the daemon"), ("busctl", "inspect D-Bus ownership"),
                   ("notify-send", "send test notifications"), ("systemctl", "manage the service")):
        line(OK if shutil.which(t) else WARN, f"{t}: {'found' if shutil.which(t) else 'missing'} ({why})")
    print()
    cmd_status(a)
    print("\nInstall")
    installed = p["state"].exists()
    line(OK if installed else INFO, "takeover installed (starts at login)" if installed else "takeover not installed (Plasma owns notifications)")
    if installed:
        rc, out = sh("systemctl", "--user", "is-enabled", "notifd.service")
        line(OK if out == "enabled" else WARN, f"notifd.service: {out or 'unknown'}")
        line(OK if p["fallback_unit"].exists() else WARN, "automatic fallback to Plasma if notifd keeps failing: "
             + ("armed" if p["fallback_unit"].exists() else "missing"), None if p["fallback_unit"].exists() else "run: notify update")
        ok_portal = p["portal"].exists() and PORTAL_MARK in p["portal"].read_text()
        line(OK if ok_portal else WARN, "Flatpak/portal notifications routed through notifd: " + ("yes" if ok_portal else "NO"),
             None if ok_portal else "run: notify portal")
        line(OK if kwin_loaded() else WARN, "automatic Do Not Disturb for full-screen windows: " + ("active" if kwin_loaded() else "KWin script not loaded"),
             None if kwin_loaded() else "run: notify autodnd install")
        ts = tray_state()
        if ts == "shown":
            line(WARN, "Plasma's own notification icon is still in the system tray (it does nothing now)", "run: notify tray hide")
    print()
    rc = cmd_rules(argparse.Namespace(file=None, json=False))
    print()
    cmd_apps(a)
    return rc


# ============================================================ apps
CHROMIUM_FAMILY = [
    ("Brave Origin", HOME / ".config/BraveSoftware/Brave-Origin", "brave-origin"),
    ("Brave",        HOME / ".config/BraveSoftware/Brave-Browser", "brave"),
    ("Chrome",       HOME / ".config/google-chrome", "chrome"),
    ("Chromium",     HOME / ".config/chromium", "chromium"),
    ("Vivaldi",      HOME / ".config/vivaldi", "vivaldi"),
    ("Edge",         HOME / ".config/microsoft-edge", "msedge"),
]
RUNNING_NEEDLES = {   # executable paths that mean "this browser is running" (specific: Electron apps ship chrome_* helpers)
    "brave-origin": ("brave-origin",), "brave": ("brave-bin", "brave.com", "brave-browser"),
    "chrome": ("google-chrome", "/opt/google/chrome"), "chromium": ("/usr/lib/chromium", "/chromium/chromium"),
    "vivaldi": ("vivaldi",), "msedge": ("microsoft-edge", "msedge"),
}
ELECTRON = ["Claude", "discord", "Slack", "Signal", "Cursor", "Code", "obsidian", "Proton Mail"]


def chromium_profile(base: Path):
    """Readiness facts for a Chromium-family user-data dir. Counts only; no site names."""
    prefs = base / "Default" / "Preferences"
    if not prefs.exists():
        return None
    try:
        d = json.loads(prefs.read_text())
    except (OSError, ValueError):
        return {"error": "unreadable Preferences"}
    cs = d.get("profile", {}).get("content_settings", {}).get("exceptions", {}).get("notifications", {})
    return {"allowed": sum(1 for v in cs.values() if isinstance(v, dict) and v.get("setting") == 1),
            "blocked": sum(1 for v in cs.values() if isinstance(v, dict) and v.get("setting") == 2),
            "gcm_channel": d.get("brave", {}).get("gcm", {}).get("channel_status")}


def firefox_profiles():
    """Profile folders from profiles.ini in every place Firefox keeps them (XDG, classic, Flatpak)."""
    out = []
    for root in (HOME / ".config/mozilla/firefox", HOME / ".mozilla/firefox", HOME / ".var/app/org.mozilla.firefox/.mozilla/firefox"):
        ini = root / "profiles.ini"
        if not ini.exists():
            continue
        cp = configparser.ConfigParser()
        try:
            cp.read(ini)
        except configparser.Error:
            continue
        for sec in cp.sections():
            if sec.startswith("Profile") and cp.has_option(sec, "Path"):
                p = cp.get(sec, "Path")
                rel = cp.get(sec, "IsRelative", fallback="1") == "1"
                d = root / p if rel else Path(p)
                if d.exists():
                    out.append((cp.get(sec, "Name", fallback=d.name), d))
    return out


def firefox_notification_perms(profile: Path):
    db = profile / "permissions.sqlite"
    if not db.exists():
        return None
    try:
        con = sqlite3.connect(f"file:{db}?mode=ro&immutable=1", uri=True, timeout=2)
        rows = con.execute("select permission, count(*) from moz_perms where type='desktop-notification' group by permission").fetchall()
        con.close()
    except sqlite3.Error:
        return None
    m = dict(rows)
    return m.get(1, 0), m.get(2, 0)


def apps_data():
    chromium = []
    for name, base, entry in CHROMIUM_FAMILY:
        if not base.exists():
            continue
        f = chromium_profile(base)
        item = {"name": name, "profile": f is not None and "error" not in f, "running": exe_running(*RUNNING_NEEDLES.get(entry, (entry,)))}
        if f and "error" not in f:
            item.update(allowed=f["allowed"], blocked=f["blocked"], push=bool(f["gcm_channel"]))
        elif f:
            item["error"] = f["error"]
        chromium.append(item)
    flat = [Path(p).name for p in glob.glob(str(HOME / ".var/app/*Chrom*")) + glob.glob(str(HOME / ".var/app/*Brave*"))]
    ff = []
    for name, d in firefox_profiles():
        perms = firefox_notification_perms(d)
        ff.append({"profile": name, "allowed": perms[0] if perms else None, "blocked": perms[1] if perms else None})
    return {"chromium": chromium, "flatpak_browsers": flat, "firefox": ff,
            "electron": [x for x in ELECTRON if (HOME / ".config" / x).exists()]}


def cmd_apps(a):
    data = apps_data()
    if getattr(a, "json", False):
        print(json.dumps(data, indent=1))
        return 0
    print("Chromium-family browsers")
    for c in data["chromium"]:
        if "error" in c:
            line(WARN, f"{c['name']}: {c['error']}")
        elif not c["profile"]:
            line(INFO, f"{c['name']}: profile folder exists, no Default profile")
        else:
            line(OK if c["allowed"] else INFO, f"{c['name']}{' (running)' if c['running'] else ''}: {c['allowed']} sites allowed, "
                                              f"{c['blocked']} blocked, push (GCM) {'on' if c['push'] else 'off/unset'}")
            if c["name"].startswith("Brave") and not c["push"]:
                line(INFO, "web push needs Google push messaging enabled", "see: notify adapt")
    for n in data["flatpak_browsers"]:
        line(INFO, f"Flatpak browser: {n} (its notifications use the portal; see: notify portal)")
    print("Firefox-family")
    for f in data["firefox"]:
        extra = f", {f['allowed']} sites allowed, {f['blocked']} blocked" if f["allowed"] is not None else ""
        line(INFO, f"profile '{f['profile']}'{extra} (web notifications carry no site name, so rules can only match their text)")
    if not data["firefox"]:
        line(INFO, "no Firefox profile found")
    print("Electron / native apps (use system notifications, nothing to adapt)")
    line(INFO, ", ".join(data["electron"]) if data["electron"] else "none found")
    return 0


# ============================================================ takeover / update / restore / portal
def unit_text(payload):
    qs = shutil.which("qs") or "/usr/bin/qs"
    return f"""[Unit]
Description=notifd notification daemon (owns org.freedesktop.Notifications)
# Start before plasmashell so we claim the name first; Plasma then runs without it.
After=plasma-kwin_wayland.service
Before=plasma-plasmashell.service
PartOf=graphical-session.target
# If notifd keeps failing to start (5 failed starts within 3 minutes, about a minute of
# trying), hand notifications back to Plasma instead of leaving none.
OnFailure=notifd-fallback.service
StartLimitIntervalSec=180
StartLimitBurst=5

[Service]
Type=dbus
BusName=org.freedesktop.Notifications
ExecStart={qs} -p {payload}
Restart=always
RestartSec=1
TimeoutStartSec=12
Slice=session.slice
# notifd needs nothing privileged: it cannot gain privileges, and files it creates (history, state) are private to you.
NoNewPrivileges=yes
UMask=0077
LockPersonality=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=plasma-core.target
"""


def fallback_unit_text():
    return f"""[Unit]
Description=Hand notifications back to Plasma because notifd failed

[Service]
Type=oneshot
ExecStart={exe_path()} restore --auto
"""


def dbus_text():
    return """[D-BUS Service]
Name=org.freedesktop.Notifications
Exec=/usr/bin/false
SystemdService=notifd.service
"""


class Plan:
    """Ordered steps: printed in a dry run, executed otherwise."""
    def __init__(self, dry):
        self.dry, self.steps = dry, []

    def add(self, desc, fn=None):
        self.steps.append((desc, fn))

    def run(self):
        for i, (desc, fn) in enumerate(self.steps, 1):
            print(f"  {i}. {desc}")
            if not self.dry and fn:
                fn()


def portal_enable(a):
    p = paths()
    if p["portal"].exists() and PORTAL_MARK not in p["portal"].read_text():
        print(f"  ! {p['portal']} already exists and was not made by notify; leaving it alone")
        return False
    if not Path("/usr/share/xdg-desktop-portal/portals/gtk.portal").exists():
        print("  ! xdg-desktop-portal-gtk is not installed (it provides the notification route notifd needs)")
